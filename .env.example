# Todas son opcionales: el laboratorio arranca sin ninguna.

# Lista blanca de seriales, separados por coma. Vacio = acepta cualquiera.
ZK_ALLOWED_SN=CNYG213260182

# Sello de marcaciones. Alto = el equipo se considera al dia y solo empuja
# marcaciones nuevas. 0 = reenvia TODO el historico (44.718 registros).
ZK_ATTLOG_STAMP=9999999999
ZK_OPERLOG_STAMP=9999999999

# Que datos se piden. Ampliar trae plantillas biometricas y fotos.
ZK_TRANS_FLAG=TransData AttLog
ZK_TIMEZONE=-5

# Copia de cada trama a un visor externo (webhook.site). Opcional.
MIRROR_URL=

# Almacen persistente. Los inyecta sola la integracion de Upstash en Vercel.
# Sin ellos el panel funciona en memoria, que es volatil.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
